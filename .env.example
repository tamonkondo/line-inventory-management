# =============================================================
# 環境変数テンプレート(すべてダミー値)
# ・このファイルをコピーして .env を作る: cp .env.example .env
# ・.env は gitignore 済み。実際の値は絶対にコミットしないこと
# ・GASの実行時はここではなく「スクリプトプロパティ」から読む。
#   .env はローカル開発・セットアップ作業時の控えとして使い、
#   同じキー名でスクリプトプロパティに登録する(docs/implementation/15-setup-e2e.md 参照)
# =============================================================

# --- LINE Messaging API (LINE Developers コンソール > チャネル設定) ---
LINE_CHANNEL_ACCESS_TOKEN=dummy-line-channel-access-token-xxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_SECRET=dummy0line0channel0secret0000000

# --- Notion API (https://www.notion.so/my-integrations) ---
# *_DB_ID には各DBの「データソースID」を設定する
# (Notion: DB設定 > データソースを管理 > 「⋯」> データソースIDをコピー)
NOTION_TOKEN=ntn_dummy00000000000000000000000000000000000000
NOTION_INVENTORY_DB_ID=00000000000000000000000000000001
NOTION_USERS_DB_ID=00000000000000000000000000000002
NOTION_PURCHASES_DB_ID=00000000000000000000000000000003

# --- GAS / clasp ---
# リッチメニュー画像(Google Drive のファイルID)
RICHMENU_IMAGE_FILE_ID=dummy-drive-file-id-xxxxxxxxxxxxx
# GASプロジェクトのスクリプトID(.clasp.json に設定する値の控え)
CLASP_SCRIPT_ID=dummy-gas-script-id-xxxxxxxxxxxxxxxxxxxxxxxxx
